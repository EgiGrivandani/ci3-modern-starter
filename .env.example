APP_NAME="CI3 Modern Starter"
APP_ENV=development
APP_KEY=
APP_URL=http://ci3-modern-starter.test/
APP_TIMEZONE=Asia/Jakarta
LOG_THRESHOLD=1

CSRF_PROTECTION=true
COOKIE_SECURE=false
TRUST_CLOUDFLARE=false

# Cache & Rate Limiter Driver: file | redis | memcached | apcu
CACHE_DRIVER=file
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

DB_CONNECTION=mysqli
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ci3_starter
DB_USERNAME=root
DB_PASSWORD=

# Mail / SMTP Configuration (protocol: smtp | sendmail | mail)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_TIMEOUT=10
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="CI3 Modern Starter"

