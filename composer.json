{
	"name": "starter/ci3-modern-starter",
	"description": "CodeIgniter 3 Modern Starter Template with PHP 8.5, public directory, .env support, and DDIA engineering standards",
	"type": "project",
	"license": "MIT",
	"require": {
		"php": ">=8.0",
		"vlucas/phpdotenv": "^5.6"
	},
	"require-dev": {
		"friendsofphp/php-cs-fixer": "^3.95",
		"phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
	},
	"autoload": {
		"psr-4": {
			"App\\": "application/"
		},
		"files": [
			"application/helpers/app_helper.php"
		],
		"exclude-from-classmap": [
			"application/config/",
			"application/controllers/",
			"application/core/",
			"application/helpers/",
			"application/hooks/",
			"application/language/",
			"application/libraries/",
			"application/models/",
			"application/migrations/",
			"application/views/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"scripts": {
		"check": "@php scripts/check.php",
		"format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential --format=txt",
		"format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --sequential --format=txt --dry-run --diff",
		"test": "phpunit --colors=always",
		"migrate": "php public/index.php migrate"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	}
}
